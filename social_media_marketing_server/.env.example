# Gemini AI Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# LLM Logging Level
# Options: FULL, TIMING, ERRORS, NONE
# FULL - Log complete prompts, responses, timing, costs (development/debugging)
# TIMING - Log only metrics, no full prompts/responses (production)
# ERRORS - Log only failures (production)
# NONE - Disable logging (not recommended)
LLM_LOGGING_LEVEL=FULL

# Database Configuration (already configured by Serverpod)
# These are handled by docker-compose.yaml and config files

# Add other environment variables as needed
